// wrangler.jsonc - Cloudflare Workers configuration for portfolio API
{
  // Replace with your actual Cloudflare Account ID
  // Get from: Cloudflare Dashboard -> Workers & Pages -> Account ID
  "$schema": "https://schemas.cloudflare.com/wrangler/v3-2025-01-17/json-schema/",
  name: "portfolio-api",
  main: "src/index.ts",
  compatibility_date: "2025-01-17",
  compatibility_flags: ["nodejs_compat"],
  
  // Environment variables - set these in Cloudflare Dashboard or via wrangler secret
  // wrangler secret put CLOUDFLARE_ACCOUNT_ID
  // wrangler secret put CLOUDFLARE_API_TOKEN
  // wrangler secret put DATABASE_URL (optional, for Neon)
  
  observability: {
    enabled: true,
  },
  
  // Optional: KV namespace for caching
  // kv_namespaces: [
  //   { binding: "PORTFOLIO_CACHE", id: "your_kv_namespace_id" },
  // ],
  
  // Optional: D1 database binding
  // d1_databases: [
  //   { binding: "DB", database_name: "portfolio-db", database_id: "your_d1_database_id" },
  // ],
  
  // Optional: R2 bucket for 3D models/assets
  // r2_buckets: [
  //   { binding: "ASSETS", bucket_name: "portfolio-assets" },
  // ],
}