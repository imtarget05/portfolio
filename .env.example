# ⚠️ SECURITY: This file contains only PLACEHOLDER values.
# Copy to .env and replace with real values. Never commit .env to git.

# -----------------------------------------------------------
# Phase 1: Neon PostgreSQL (optional - only if using chat history)
# -----------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# -----------------------------------------------------------
# Phase 2: Cloudflare Workers (Edge Serverless)
# Get these from Cloudflare Dashboard -> Workers & Pages
# -----------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# -----------------------------------------------------------
# Cloudflare Vectorize (RAG) - Optional, Post-MVP
# -----------------------------------------------------------
VECTORIZE_INDEX_ID=your_vectorize_index_id
VECTORIZE_API_TOKEN=your_cloudflare_api_token

# -----------------------------------------------------------
# Cloudflare R2 (Object Storage) - Optional, for large 3D models
# -----------------------------------------------------------
R2_BUCKET_NAME=your_r2_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# -----------------------------------------------------------
# Cloudflare D1 (Serverless SQL) - Optional, Post-MVP
# -----------------------------------------------------------
D1_DATABASE_ID=your_d1_database_id

# -----------------------------------------------------------
# Site URL (for SEO, sitemap, canonical links)
# -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://portfolio-of-mainguyenbinhtan.onrender.com
